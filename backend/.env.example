# Application
APP_ENV=development
APP_NAME=RestaurantOS API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-restaurant MVP (set after seeding, or use default from migration seed)
RESTAURANT_ID=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/restaurantos
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Development auth (only when FIREBASE_ENABLED=false, never in production)
DEV_AUTH_ENABLED=false
DEV_AUTH_TOKEN=dev-local-token
DEV_AUTH_FIREBASE_UID=dev-firebase-uid
DEV_AUTH_EMAIL=admin@restaurantos.local
DEV_AUTH_NAME=Dev Admin
DEV_AUTH_ROLE=admin

# Firebase Authentication
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON inside container or on host
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-credentials.json
# Optional: Firebase Auth emulator (local development)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase Cloud Messaging
FCM_ENABLED=true

# Supabase (storage — used in later phases)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_MENU=menu-images

# OpenAPI / docs
DOCS_ENABLED=true

# Migrations check on /ready (set false if DB not migrated yet)
READY_CHECK_MIGRATIONS=false
